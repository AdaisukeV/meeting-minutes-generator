# Google Cloud Vertex AI 経由で Claude を利用する場合のテンプレート(docs/design/04-auth.md §2.1)。
#
# 使い方:
#   cp config/auth/vertex.env.example config/auth/active.env
#
# GCP の認証情報そのものはここに書かない(gcloud auth application-default login 等で取得する)。

# Claude Code を Vertex AI 経由で動かす
CLAUDE_CODE_USE_VERTEX=1

# Vertex AI のリージョン
CLOUD_ML_REGION=asia-northeast1

# Vertex AI を利用する GCP プロジェクトID
ANTHROPIC_VERTEX_PROJECT_ID=my-gcp-project

# 使用するモデルIDを明示的に固定する(エイリアス不可・要件3.4)
ANTHROPIC_MODEL=<Vertex のモデルID>

# (任意)ステップ別のモデルID(要件3.4 / docs/design/02-generate-minutes.md §5.1)。
# 未設定のステップは上の ANTHROPIC_MODEL を使う。
# ANTHROPIC_MODEL_STEP1=<Vertex のモデルID>
# ANTHROPIC_MODEL_STEP2=<Vertex のモデルID>
# ANTHROPIC_MODEL_STEP3=<Vertex のモデルID>

# (任意)1回の claude 呼び出しが返せる出力トークンの上限(claude CLI が解決する)。
# 既定は 32000。ステップ1・2は全発言を書き直すため長い会議では超過して
# `API Error: ... exceeded the 32000 output token maximum` で失敗する。
# --parallel でパートを小さくするか、この値を上げる(docs/design/02-generate-minutes.md §9.6)。
# CLAUDE_CODE_MAX_OUTPUT_TOKENS=64000

# (任意)thinking(拡張思考)を無効にする。**所要時間に最も効く設定**(実測)。
# thinking は上の出力トークン上限を本文と共有するため、思考が長引くと本文の予算が減り、
# claude が応答を自動継続して「先頭が失われた出力」を返しやすくなる。実測では本文を
# 1文字も出さない thinking のみの応答が繰り返され、ステップ3が41分かかっていた。
# これを設定すると同じ入力が 1分52秒 で完了し、自動継続も起きなくなった
# (docs/design/09-decisions.md 6.5・6.6)。本アプリのステップ1〜3は規則に沿った
# 書き換え・整形が主で長い思考を要さないため、既定で有効にしてよい。
# CLAUDE_CODE_DISABLE_THINKING=1

# (任意)thinking の予算を上限トークン数で絞る。
# **実測では効果が確認できなかった**(8000 を指定しても thinking が出力上限32,000を
# 使い切った。docs/design/09-decisions.md 6.6)。上の CLAUDE_CODE_DISABLE_THINKING を優先する。
# MAX_THINKING_TOKENS=8000
